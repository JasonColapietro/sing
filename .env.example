# Stripe — provisioned by the Vercel Marketplace integration, which sets these
# on the project automatically. Locally, run:
#
#   vercel link && vercel env pull
#
# Never commit real values; .env* is gitignored.

# Server-side only. Used by every route under app/api.
STRIPE_SECRET_KEY=sk_test_...

# Injected by the integration. Unused today — checkout is Stripe-hosted, so no
# card fields are ever rendered by this app — but kept for future client SDK use.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Prices are resolved at runtime by lookup key, and checkout refuses to open a
# session when the resolved price disagrees with the table in lib/pro-shared.ts
# (amount and interval both checked). The keys the code expects:
#   suede_pro_monthly   $9.99 / month
#   suede_pro_annual   $79.00 / year   (create it: npm run stripe:setup -- annual)
#
# Optional pins: skip lookup-key resolution and use an exact price id. The
# amount/interval check still applies.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# The yearly plan is invisible until this is "1". Flip it only after the
# suede_pro_annual price above exists at $79/yr — until then the pricing page,
# homepage teaser and JSON-LD all stay monthly-only on their own.
NEXT_PUBLIC_PRO_ANNUAL=

# Comma-separated comp codes. Each one redeems at /pro for a 30-day Pro pass —
# a real Stripe subscription opened as a trial, with no card collected, that
# cancels itself when the 30 days are up. Matching ignores case and whitespace.
# Deleting a code here stops new redemptions; passes already started run out
# their 30 days. Unset means no code works.
#
# Make them long and unguessable — they are typed into a public form, and the
# in-process rate limiter is a floor, not a lock:
#   node -e "console.log('SUEDE-'+require('crypto').randomBytes(6).toString('hex').toUpperCase())"
PRO_COMP_CODES=

# Signs the Pro keys that restore a subscription on another device. Any high
# entropy string; rotating it invalidates every key already handed out.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PRO_KEY_SECRET=
